    <!-- Giải pháp -->
    <string name="sol_title">Cách khắc phục</string>
    <string name="sol_boot">Đây là những gì attestation phần cứng (TEE) báo cáo về trạng thái boot. Các công cụ vượt qua keybox (TrickyStore, TEE Simulator, OhMyKeyMint) chỉ viết lại attestation cho các ứng dụng bạn chỉ định. Thêm gói của ứng dụng này vào danh sách mục tiêu của các công cụ đó (ví dụ target.txt) để attestation của nó báo cáo thiết bị đã khóa với verified boot màu xanh.</string>
    <string name="sol_root_detector">Các ứng dụng đã cài đặt này tìm kiếm root, giả lập hoặc Play Integrity thất bại. Thêm các gói tìm thấy ở đây làm mục tiêu vào framework ẩn của bạn (HMA-OSS) để ứng dụng và mô-đun root của bạn được ẩn khỏi các trình phát hiện này.</string>
    <string name="sol_spoof">Cài đặt này được đọc khác nhau qua các đường dẫn mà một ứng dụng có thể dùng (spoof không bao phủ tất cả). Thêm cài đặt vào preset spoof của HMA-OSS để mọi đường dẫn đọc trả về cùng một giá trị.</string>
    <string name="sol_attest_patch">key attestation báo mức vá khác với thuộc tính hệ thống. Đặt trong công cụ keybox của bạn - TrickyStore ở security_patch.txt (một ngày, hoặc system=/boot=/vendor=/all=, hoặc \'prop\'); OhMyKeymint ở config.toml trong [trust]. Cả hai chỉ đổi attestation, không đổi thuộc tính.</string>
    <string name="sol_patch_prop">Build.VERSION.SECURITY_PATCH (framework) và thuộc tính ro.build.version.security_patch hiển thị ngày khác nhau. Căn chỉnh bằng resetprop. security_patch.txt và config.toml không giúp được ở đây - chúng chỉ đổi key attestation, không đổi thuộc tính.</string>

    <string name="note_gsf">Không có trên Android 16 trở lên: kho dịch vụ Google đã chuyển vào Play Services, cửa của nó được chính Google đặt tên &quot;do.not.use&quot; và không trả lời các ứng dụng khác. Cả hai đều được thử ở trên.</string>
