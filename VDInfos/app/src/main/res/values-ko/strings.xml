    <string name="t_isrc_gap_forged_store_install">설치 프로그램 스토어 일관성</string>
    <string name="t_isrc_gap_store_pkgsource_other">불일치: 스토어 설치 프로그램이나 packageSource가 스토어와 다름</string>
    <string name="t_loop_orphan">고아 loop 장치</string>
